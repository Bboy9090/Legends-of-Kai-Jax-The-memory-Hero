{
  "name": "legends-of-kai-jax",
  "version": "1.0.0",
  "description": "The Legends of Kai-Jax: The Memory Hero - A Mythic Platform Fighter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -C apps/web dev --host",
    "build": "pnpm -C apps/web build",
    "preview": "pnpm -C apps/web preview --host",
    "typecheck": "pnpm -C apps/web typecheck",
    "lint": "pnpm -C apps/web lint",
    "cap:sync": "pnpm -C apps/web cap:sync",
    "cap:open": "pnpm -C apps/web cap:open",
    "game:install": "pnpm -C apps/web install",
    "game:dev": "pnpm -C apps/web dev --host",
    "game:build": "pnpm -C apps/web build",
    "game:preview": "pnpm -C apps/web preview --host",
    "game:typecheck": "pnpm -C apps/web typecheck",
    "game:lint": "pnpm -C apps/web lint",
    "desktop:dev": "pnpm -C apps/desktop dev",
    "desktop:build": "pnpm game:build && pnpm -C apps/desktop build",
    "mobile:dev": "pnpm -C apps/mobile dev",
    "mobile:build": "pnpm -C apps/mobile build",
    "legacy:dev": "vite --host 0.0.0.0 --port 5000",
    "legacy:build": "vite build",
    "legacy:preview": "vite preview",
    "legacy:start": "NODE_ENV=production tsx server/index.ts",
    "db:push": "drizzle-kit push",
    "validate:model": "python3 assets/models/characters/kai-jax/validate_model.py",
    "validate:registry": "node apps/web/scripts/validate-registry.mjs",
    "inspect:glb": "node apps/web/scripts/inspect-glb.mjs",
    "test": "pnpm -C apps/web test",
    "start": "serve -s apps/web/dist -l 5000"
  },
  "keywords": [
    "pwa",
    "game",
    "platform-fighter",
    "The Legends of Kai-Jax"
  ],
  "author": "The Silent Architect",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/ios": "^5.7.8",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.9.6",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.10.8",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@react-three/postprocessing": "^3.0.4",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.8",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express-rate-limit": "^8.6.1",
    "lucide-react": "^0.561.0",
    "postcss": "^8.5.25",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.2",
    "serve": "^14.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tsx": "^4.23.1",
    "usb": "^2.17.0",
    "vite": "^6.4.2",
    "vite-plugin-glsl": "^1.6.1",
    "zustand": "^5.0.9"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
