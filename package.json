{
  "name": "legends-of-kai-jax",
  "version": "1.0.0",
  "description": "The Legends of Kai-Jax: The Memory Hero - A Mythic Platform Fighter",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C apps/web dev --host",
    "build": "pnpm -C apps/web build",
    "preview": "pnpm -C apps/web preview --host",
    "game:install": "pnpm -C apps/web install",
    "game:dev": "pnpm -C apps/web dev --host",
    "game:build": "pnpm -C apps/web build",
    "game:preview": "pnpm -C apps/web preview --host",
    "game:typecheck": "pnpm -C apps/web typecheck",
    "game:lint": "pnpm -C apps/web lint",
    "desktop:dev": "pnpm -C apps/desktop dev",
    "desktop:build": "pnpm game:build && pnpm -C apps/desktop build",
    "mobile:dev": "pnpm -C apps/mobile dev",
    "mobile:build": "pnpm -C apps/mobile build",
    "legacy:dev": "vite --host 0.0.0.0 --port 5000",
    "legacy:build": "vite build",
    "legacy:preview": "vite preview",
    "legacy:start": "NODE_ENV=production tsx server/index.ts",
    "db:push": "drizzle-kit push",
    "validate:canon": "node validate-canon.mjs",
    "validate:memory": "node validate-memory-layers.mjs",
    "validate:model": "python3 assets/models/characters/kai-jax/validate_model.py",
    "test": "echo 'Testing...' && node -e \"console.log('✅ Node.js ready')\"",
    "start": "serve -s apps/web/dist -l 5000"
  },
  "keywords": [
    "pwa",
    "game",
    "platform-fighter",
    "The Legends of Kai-Jax"
  ],
  "author": "The Silent Architect",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "turbo": "^2.6.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@react-three/postprocessing": "^3.0.4",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.8",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express-rate-limit": "^8.3.2",
    "lucide-react": "^0.561.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "serve": "^14.2.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "tsx": "^4.21.0",
    "usb": "^2.17.0",
    "vite": "^6.4.1",
    "vite-plugin-glsl": "^1.3.1",
    "zustand": "^5.0.9"
  }
}
