{
  "name": "@legends-of-kai-jax/desktop",
  "version": "1.0.0",
  "description": "Legends of Kai-Jax: The Memory Hero - Transcendent Legendary Enterprise Desktop App",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "tsc && electron .",
    "build:ts": "tsc",
    "build": "tsc && electron-builder",
    "build:win": "tsc && electron-builder --win",
    "build:mac": "tsc && electron-builder --mac",
    "build:linux": "tsc && electron-builder --linux",
    "pack": "tsc && electron-builder --dir",
    "watch": "tsc --watch",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rm -rf dist"
  },
  "build": {
    "appId": "com.legends-of-kai-jax.desktop",
    "productName": "Legends of Kai-Jax",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "../web/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "electron-updater": "^6.1.7",
    "express": "^5.2.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.30",
    "@types/ws": "^8.18.1",
    "electron": "^35.7.5",
    "electron-builder": "^24.9.1",
    "typescript": "^5.6.3"
  }
}
