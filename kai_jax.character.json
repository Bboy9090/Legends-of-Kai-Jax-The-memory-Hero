  "designPrinciples": {
    "silhouetteFirst": "If the silhouette reads, you win. If it breaks when scaled down, you lose.",
    "layeredRendering": "Characters are stacked render layers, not textures on geometry",
    "lodStrategy": "Reduce layers, not polycount. Identity must survive all distances.",
    "pcFirst": "Design for PC, scale to tablet, then mobile. Never compromise core experience.",
    "deterministicBehavior": "Same input always produces same output. No randomness in core systems.",
    "noPlaceholderLogic": "All features must be fully implemented or clearly marked as future."
  },
  "validation": {
    "requiredFields": [
      "id",
      "name",
      "displayName",
      "appearance.primaryColor",
      "appearance.accentColor",
      "combat.baseStats",
      "rendering.lodLevels"
    ],
    "colorFormat": "Must be valid hex color (#RRGGBB or #RGB)",
    "statRanges": {
      "power": [0, 100],
      "speed": [0, 100],
      "defense": [0, 100],
      "gravity": [0, 20]
    }
