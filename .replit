modules = ["nodejs-20"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[nix]
channel = "stable-25_05"

[deployment]
build = ["sh", "-c", "npm install --legacy-peer-deps && cd apps/web && npx vite build"]
run = ["sh", "-c", "node serve.js "]
deploymentTarget = "cloudrun"
publicDir = "dist"
